      },
      {
        "colId": "Nombre_de_periodes_de_stage",
        "label": "Nombre de périodes de stage",
        "type": "Numeric",
        "isFormula": true,
        "formula": "len(Periodes_de_stage.lookupRecords(Classe=$id))"
      },
      {
        "colId": "Professeur_principal",
        "label": "Professeur principal",
        "type": "Ref:Enseignants",
