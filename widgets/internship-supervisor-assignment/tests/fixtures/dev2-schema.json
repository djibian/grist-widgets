  {
    "tableId": "Enseignants",
    "columns": [
      {
        "colId": "Identite",
        "label": "Identité",
        "type": "Any",
        "isFormula": true,
        "formula": "f\"{$Titre} {$Nom} {$Prenom}\".strip()"
      },
      {
        "colId": "Latitude",
        "label": "Latitude",
