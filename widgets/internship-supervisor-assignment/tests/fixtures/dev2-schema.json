        "isFormula": false,
        "formula": ""
      },
      {
        "colId": "Localisation_validee",
        "label": "Localisation validée",
        "type": "Bool",
        "isFormula": false,
        "formula": ""
      }
    ]
  },
  {
    "tableId": "Affectation",
    "columns": [
      {
        "colId": "Enseignant",
        "label": "Enseignant",
        "type": "Ref:Enseignants",
        "isFormula": false,
        "formula": "",
        "visibleColumnId": "Identite"
      },
      {
        "colId": "Classe",
        "label": "Classe",
        "type": "Ref:Classes",
        "isFormula": false,
        "formula": "",
        "visibleColumnId": "Classe"
      },
      {
        "colId": "Stage_a_suivre",
        "label": "Stage à suivre",
        "type": "Numeric",
        "isFormula": false,
        "formula": ""
      },
      {
        "colId": "Stages_attribues",
        "label": "Stages attribués",
        "type": "Numeric",
        "isFormula": true,
        "formula": "sum(\n    1 for s in Stages.lookupRecords(\n        Suivi_par=$Enseignant,\n        Classe=$Classe,\n        Periode=$Periode\n    )\n    if s.Structure_de_stage\n)"
      },
      {
        "colId": "Periode",
        "label": "Période",
        "type": "Ref:Periodes_de_stage",
        "isFormula": false,
        "formula": "",
        "visibleColumnId": "Periode"
      },
      {
        "colId": "Reste_a_attribuer",
        "label": "Reste à attribuer",
        "type": "Any",
        "isFormula": true,
        "formula": "$Stage_a_suivre - $Stages_attribues"
      }
    ]
  },
  {
    "tableId": "Periodes_de_stage",
    "columns": [
      {
        "colId": "Classe",
        "label": "Classe",
        "type": "Ref:Classes",
        "isFormula": false,
        "formula": "",
        "visibleColumnId": "Classe"
      },
      {
        "colId": "Numero",
        "label": "Numéro",
        "type": "Text",
        "isFormula": false,
        "formula": ""
      },
      {
        "colId": "Periode",
        "label": "Période",
        "type": "Text",
        "isFormula": true,
        "formula": "if $Numero:\n    debut_str = f\"{$Date_debut.day:02d}/{$Date_debut.month:02d}/{$Date_debut.year}\" if $Date_debut else \"\"\n    fin_str = f\"{$Date_fin.day:02d}/{$Date_fin.month:002d}/{$Date_fin.year}\" if $Date_fin else \"\"\n\n    if debut_str and fin_str:\n        return f\"{$Numero} - {$Classe.Classe} - {debut_str} au {fin_str}\"\n    elif debut_str:\n        return f\"{$Numero} - {$Classe.Classe} - {debut_str}\"\n    elif fin_str:\n        return f\"{$Numero} - {$Classe.Classe} - {fin_str}\"\n\"\""
      },
      {
        "colId": "Effectif",
        "label": "Effectif",
        "type": "Numeric",
        "isFormula": true,
        "formula": "len(Eleves.lookupRecords(Classe=$Classe))"
      },
      {
        "colId": "Stages_declares",
        "label": "Stages déclarés",
        "type": "Numeric",
        "isFormula": true,
        "formula": "stages = Stages.lookupRecords(Periode=$id)\n\nlen({\n    s.Eleve.id\n    for s in stages\n    if s.Eleve and s.Structure_de_stage\n})"
      },
      {
        "colId": "Sans_stage",
        "label": "Sans stage",
        "type": "Numeric",
        "isFormula": true,
        "formula": "max(0, $Effectif - $Stages_declares)"
      },
      {
        "colId": "Stages_attribues",
        "label": "Stages attribués",
        "type": "Numeric",
        "isFormula": true,
        "formula": "sum(\n    1 for s in Stages.lookupRecords(Periode=$id)\n    if s.Structure_de_stage and s.Suivi_par\n)"
      },
      {
        "colId": "Stages_sans_enseignants",
        "label": "Stages sans enseignants",
        "type": "Numeric",
        "isFormula": true,
        "formula": "sum(\n    1 for s in Stages.lookupRecords(Periode=$id)\n    if s.Structure_de_stage and not s.Suivi_par\n)"
      }
    ]
  }
]
